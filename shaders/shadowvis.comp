#version 460
#include "common.glsl"
#include "terrain_shadow.glsl"
// Sun visibility for every texel of one terrain shadow height map (pc.lightIndex = level),
// by marching the maps towards the sun out to 32 km with Earth curvature and a soft
// penumbra. Re-run only when the sun moved noticeably or a map was re-centred.
layout(local_size_x = 8, local_size_y = 8) in;

void main() {
    uint l = pc.lightIndex;
    uint target = l == 0u ? STOR_SHADOW_VIS_NEAR : STOR_SHADOW_VIS_FAR;
    ivec2 size = imageSize(gStorage[target]);
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(px, size))) return;
    float extent = FRAME.shadowOffset[l].w;
    if (extent <= 0.0) { imageStore(gStorage[target], px, vec4(1.0)); return; }

    vec2 uv = (vec2(px) + 0.5) / vec2(size);
    vec3 local = vec3((uv.x - 0.5) * extent, (0.5 - uv.y) * extent, 0.0);
    vec3 p = FRAME.shadowOffset[l].xyz + transpose(mat3(FRAME.shadowEnu[l])) * local; // camera-relative ECEF
    float h0 = textureLod(gTextures[l == 0u ? TEX_SHADOW_NEAR : TEX_SHADOW_FAR], uv, 0.0).r;

    vec3 sunEcef = transpose(mat3(FRAME.ecefToEnu)) * FRAME.sunDir.xyz;
    vec3 up = transpose(mat3(FRAME.shadowEnu[l]))[2]; // anchor up (ECEF)
    float mu = dot(up, sunEcef);
    float vis = 1.0;
    if (mu < -0.05) vis = 0.0;
    else {
        const float R = 6371000.0;
        float texel = l == 0u ? FRAME.shadowParams.y : FRAME.shadowParams.z;
        float maxH = FRAME.shadowParams.w;
        float t = texel * 1.5;
        for (int i = 0; i < 64 && t < 32000.0; ++i) {
            float hr = h0 + 2.0 + t * mu + t * t * (1.0 - mu * mu) / (2.0 * R);
            if (hr > maxH + 5.0 && mu > 0.0) break; // above every peak: lit
            float hm;
            if (!shadowMapHeight(p + sunEcef * t, hm)) break;
            vis = min(vis, (hr - hm) / (t * 0.035)); // penumbra (sun ≈ 0.53°)
            if (vis <= 0.0) { vis = 0.0; break; }
            t = t * 1.12 + texel * 0.5;
        }
        vis = smoothstep(0.0, 1.0, vis);
    }
    imageStore(gStorage[target], px, vec4(vis));
}
