#version 460
#include "common.glsl"
#include "atmosphere.glsl"
// Sky-view LUT for one light (pc.lightIndex: 0 = sun, 1 = moon). Re-rendered every frame.
// Stored for unit illuminance: moonlit radiance (~1e-8) would underflow fp16, so the
// light's illuminance is applied where the LUT is sampled.
layout(local_size_x = 8, local_size_y = 8) in;

void main() {
    uint target = pc.lightIndex == 0u ? TEX_SKYVIEW_SUN : TEX_SKYVIEW_MOON;
    ivec2 size = imageSize(gStorage[target]);
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, size))) return;

    vec4 light = pc.lightIndex == 0u ? FRAME.sunDir : FRAME.moonDir;
    float viewHeight = viewRadiusKm(FRAME.camera.z);

    float viewZenithCos, lightViewCos;
    skyViewParams((vec2(p) + 0.5) / vec2(size), viewHeight, viewZenithCos, lightViewCos);
    float sinZ = sqrt(max(1.0 - viewZenithCos * viewZenithCos, 0.0));
    vec3 rd = vec3(sinZ * lightViewCos, sinZ * sqrt(max(1.0 - lightViewCos * lightViewCos, 0.0)), viewZenithCos);
    float lightZenithCos = clamp(light.z, -1.0, 1.0);
    vec3 lightDir = vec3(sqrt(max(1.0 - lightZenithCos * lightZenithCos, 0.0)), 0.0, lightZenithCos);
    vec3 ro = vec3(0.0, 0.0, viewHeight);

    float tGround = raySphere(ro, rd, R_BOTTOM);
    float tTop = raySphere(ro, rd, R_TOP);
    float tMax = tGround > 0.0 ? tGround : tTop;
    float cosTheta = dot(rd, lightDir);
    float pR = rayleighPhase(cosTheta), pM = miePhase(cosTheta);

    const int STEPS = 32;
    vec3 L = vec3(0.0), throughput = vec3(1.0);
    float tPrev = 0.0;
    for (int i = 0; i < STEPS; ++i) {
        // Quadratic distribution: dense near the viewer, coarse far away.
        float t1 = tMax * pow((float(i) + 1.0) / float(STEPS), 2.0);
        float dt = t1 - tPrev;
        vec3 pos = ro + rd * (tPrev + 0.5 * dt);
        tPrev = t1;
        float h = length(pos);
        vec3 up = pos / h;
        float muL = dot(up, lightDir);
        Medium m = sampleMedium(h - R_BOTTOM);
        vec3 tLight = transmittanceToSpace(h, muL);
        vec3 S = (m.scatR * pR + vec3(m.scatM * pM)) * tLight + (m.scatR + vec3(m.scatM)) * multiScattering(h, muL);
        vec3 stepT = exp(-m.ext * dt);
        L += throughput * (S - S * stepT) / max(m.ext, vec3(1e-7));
        throughput *= stepT;
    }
    imageStore(gStorage[target], p, vec4(L, 1.0));
}
