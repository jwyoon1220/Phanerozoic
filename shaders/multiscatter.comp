#version 460
#include "common.glsl"
#include "atmosphere.glsl"
// Hillaire 2020 §5.5: second-order isotropic scattering → infinite-order factor.
layout(local_size_x = 8, local_size_y = 8) in;

void main() {
    ivec2 size = imageSize(gStorage[TEX_MULTISCATTER]);
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, size))) return;
    vec2 uv = (vec2(p) + 0.5) / vec2(size);
    float muSun = uv.x * 2.0 - 1.0;
    float r = R_BOTTOM + clamp(uv.y, 0.0, 1.0) * (R_TOP - R_BOTTOM - 0.01) + 0.005;
    vec3 sunDir = vec3(sqrt(max(1.0 - muSun * muSun, 0.0)), 0.0, muSun);
    vec3 ro = vec3(0.0, 0.0, r);

    const int DIRS = 8, STEPS = 20;
    const float isotropic = 1.0 / (4.0 * PI);
    vec3 L2 = vec3(0.0), fms = vec3(0.0);
    for (int i = 0; i < DIRS; ++i)
    for (int j = 0; j < DIRS; ++j) {
        float cosT = 1.0 - 2.0 * (float(i) + 0.5) / float(DIRS);
        float sinT = sqrt(max(1.0 - cosT * cosT, 0.0));
        float phi = 2.0 * PI * (float(j) + 0.5) / float(DIRS);
        vec3 rd = vec3(sinT * cos(phi), sinT * sin(phi), cosT);
        float tGround = raySphere(ro, rd, R_BOTTOM);
        float tTop = raySphere(ro, rd, R_TOP);
        float tMax = tGround > 0.0 ? tGround : tTop;
        float dt = tMax / float(STEPS);
        vec3 throughput = vec3(1.0), L = vec3(0.0), f = vec3(0.0);
        for (int s = 0; s < STEPS; ++s) {
            vec3 pos = ro + rd * ((float(s) + 0.5) * dt);
            float h = length(pos);
            Medium m = sampleMedium(h - R_BOTTOM);
            vec3 scat = m.scatR + vec3(m.scatM);
            vec3 stepT = exp(-m.ext * dt);
            vec3 tSun = transmittanceToSpace(h, dot(pos / h, sunDir));
            vec3 S = scat * isotropic * tSun;
            vec3 Sint = (S - S * stepT) / max(m.ext, vec3(1e-7));
            L += throughput * Sint;
            vec3 Fint = (scat - scat * stepT) / max(m.ext, vec3(1e-7));
            f += throughput * Fint;
            throughput *= stepT;
        }
        if (tGround > 0.0) {
            vec3 gp = ro + rd * tGround;
            vec3 n = normalize(gp);
            L += throughput * transmittanceToSpace(R_BOTTOM + 1e-3, dot(n, sunDir)) * max(dot(n, sunDir), 0.0) * GROUND_ALBEDO / PI;
        }
        L2 += L / float(DIRS * DIRS);
        fms += f / float(DIRS * DIRS);
    }
    vec3 psi = L2 / max(vec3(1.0) - fms, vec3(1e-4));
    imageStore(gStorage[TEX_MULTISCATTER], p, vec4(psi, 1.0));
}
